{
  "$schema": "./schema/lanekeep.schema.json",

  "include": [
    "crates/**/*.rs",
    "crates/lanekeep-rules/rules/*.ts",
    "crates/lanekeep-rules/modules/*.ts",
    "lanekeep/rules/*.ts",
    "lanekeep/modules/*.ts",
    "packages/lanekeep/*.ts",
    "scripts/*.py",
    "cmd/**/*.go"
  ],
  "exclude": [
    "**/target/**",
    "packages/lanekeep/builtin.d.ts"
  ],

  "rules": [
    "lanekeep/no-broad-except",
    "lanekeep/no-mutable-default-argument",
    "lanekeep/no-package-init",
    "lanekeep/no-context-in-struct",
    { "rule": "lanekeep/no-circular-imports", "options": {} },
    {
      "rule": "./crates/lanekeep-rules/components/one-parser-per-file.wasm",
      "options": {
        "allow": [
          "crates/lanekeep-engine/benches/*",
          "crates/lanekeep-rules/tests/*",
          "crates/lanekeep-wasm/tests/*"
        ]
      }
    },
    {
      "rule": "./crates/lanekeep-rules/components/sandbox-containment.wasm",
      "options": { "allow": ["crates/lanekeep-wasm/"] }
    },
    {
      "rule": "./crates/lanekeep-rules/components/no-ambient-authority.wasm",
      "options": {
        "allow": [
          "crates/lanekeep-core/src/changed.rs",
          "crates/lanekeep-rules/build.rs"
        ]
      }
    },
    {
      "rule": "./crates/lanekeep-rules/components/tracked-reads-only.wasm",
      "options": {
        "scope": ["crates/lanekeep-js/"],
        "allow": ["crates/lanekeep-js/src/loader.rs"]
      }
    },
    {
      "rule": "./crates/lanekeep-rules/components/no-ambient-observation.wasm",
      "options": {
        "scope": [
          "crates/lanekeep-cache/",
          "crates/lanekeep-config/",
          "crates/lanekeep-core/",
          "crates/lanekeep-query/",
          "crates/lanekeep-js/",
          "crates/lanekeep-engine/",
          "crates/lanekeep-wasm/"
        ],
        "allow": [
          "crates/lanekeep-core/src/suppression.rs",
          "crates/lanekeep-engine/benches/corpus.rs",
          "crates/lanekeep-config/src/lib.rs",
          "crates/lanekeep-core/src/limits.rs",
          "crates/lanekeep-engine/benches/crossings.rs",
          "crates/lanekeep-wasm/src/runtime.rs",
          "crates/lanekeep-wasm/tests/python_determinism.rs",
          "crates/lanekeep-wasm/tests/fixture_currency.rs"
        ]
      }
    },
    {
      "rule": "./crates/lanekeep-rules/components/deterministic-iteration.wasm",
      "options": { "scope": ["crates/lanekeep-report/", "crates/lanekeep-cache/"] }
    },
    "./lanekeep/rules/reduce-touches-no-tree.ts",
    "./lanekeep/rules/facts-must-serialize.ts",
    "./lanekeep/rules/node-handle-truthiness.ts",
    "./lanekeep/rules/no-eval-in-rules.ts",
    {
      "rule": "lanekeep/no-glob-import",
      "options": { "allow": ["*prelude*", "super::*"] }
    },
    {
      "rule": "lanekeep/no-unwrap",
      "options": {
        "allow": [
          "crates/lanekeep-engine/benches/corpus.rs",
          "crates/lanekeep-engine/benches/crossings.rs",
          "crates/lanekeep-lang-go/src/lib.rs",
          "crates/lanekeep-lang-python/src/lib.rs",
          "crates/lanekeep-lang-rust/src/lib.rs",
          "crates/lanekeep-languages/src/lib.rs",
          "crates/lanekeep-rules/build.rs",
          "crates/lanekeep-types-gen/src/lib.rs"
        ]
      }
    }
  ]
}
