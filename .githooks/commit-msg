#!/usr/bin/env bash
#
# commit-msg: enforce Conventional Commits on branch commits.
#
# The pull request title is what actually lands on main, since main takes squash
# merges only — that is validated separately in CI. This hook keeps branch history
# readable during review, and keeps the habit intact so the title comes out right.

set -euo pipefail

exec "$(dirname "$0")/../scripts/lint-commit-msg.sh" "$1"
