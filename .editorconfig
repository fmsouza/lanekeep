root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs}]
indent_size = 2

[*.md]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[LICENSE-*]
insert_final_newline = false
trim_trailing_whitespace = false
