{
  "name": "lanekeep",
  "private": true,
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "no-broad-except": ["builtin.d.ts"],
      "no-circular-imports": ["builtin.d.ts"],
      "no-default-export": ["builtin.d.ts"],
      "no-mutable-default-argument": ["builtin.d.ts"],
      "no-restricted-imports": ["builtin.d.ts"],
      "no-unused-exports": ["builtin.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./paths": "./modules/paths.ts",
    "./runtime/resolve": "./runtime/resolve.js",
    "./runtime/entry": "./runtime/entry.js",
    "./runtime/host": "./runtime/host.js",
    "./package.json": "./package.json",
    "./no-broad-except": {
      "types": "./builtin.d.ts"
    },
    "./no-circular-imports": {
      "types": "./builtin.d.ts"
    },
    "./no-default-export": {
      "types": "./builtin.d.ts"
    },
    "./no-mutable-default-argument": {
      "types": "./builtin.d.ts"
    },
    "./no-restricted-imports": {
      "types": "./builtin.d.ts"
    },
    "./no-unused-exports": {
      "types": "./builtin.d.ts"
    }
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.22.0",
    "@bytecodealliance/jco": "1.27.0",
    "typescript": "5.9.3"
  }
}
